{
  "name": "@novren/cli",
  "version": "0.1.1",
  "description": "Novren da terminale: file cifrati end-to-end, la chiave non lascia mai il tuo computer.",
  "license": "FSL-1.1-ALv2",
  "author": "Antonio Cuoco",
  "homepage": "https://novren.net",
  "keywords": [
    "novren",
    "end-to-end",
    "encryption",
    "file-transfer",
    "cli"
  ],
  "type": "module",
  "bin": {
    "novren": "dist/novren.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "verify": "npm run typecheck && npm test",
    "prepack": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "client-zip": "^2.5.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.7.3",
    "uqr": "^0.1.3",
    "vitest": "^3.2.7"
  }
}
