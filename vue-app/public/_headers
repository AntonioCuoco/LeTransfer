# ─────────────────────────────────────────────────────────────────────────────
# Novren — header di sicurezza (Cloudflare Pages)
#
# Questo file viene copiato in dist/ dal build e letto da Pages. È il posto dove
# vive la CSP **autoritativa**: in sviluppo non può stare, perché una CSP stretta
# rompe l'HMR di Vite (usa eval e websocket). Vedi vite.config.ts.
#
# ⚠️ I <<<SEGNAPOSTO>>> vanno sostituiti PRIMA del deploy. Se ne resta uno, la CSP
#    non è valida per quella direttiva e il browser blocca le richieste — con
#    l'app che sembra rotta senza dire perché. Controlla sempre la console dopo
#    il primo deploy: le violazioni CSP si leggono lì.
#
# ⚠️ Il build di produzione **non contiene `eval`** (verificato), quindi
#    `script-src 'self'` regge senza `unsafe-eval`. Se un domani aggiungi WASM
#    (E5, AI on-device) servirà `'wasm-unsafe-eval'`.
# ─────────────────────────────────────────────────────────────────────────────


# ── L'applicazione ───────────────────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://cognito-idp.eu-central-1.amazonaws.com https://eu-central-1rkwgxhzif.auth.eu-central-1.amazoncognito.com <<<API_ORIGIN>>> <<<R2_HOST>>>; frame-src https://captcha.novren.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# ── Già compilati (2026-08-13) ───────────────────────────────────────────────
#   cognito-idp.eu-central-1.amazonaws.com    L'SDK Cognito chiama qui per login,
#       registrazione e reset password. Senza, l'autenticazione muore in silenzio.
#   eu-central-1rkwgxhzif.auth...amazoncognito.com   La Hosted UI (User Pool
#       eu-central-1_RKWgXhZIf). /oauth2/callback ci fa una fetch per scambiare il
#       codice con i token: senza, il login Google si ferma a metà, dopo che
#       l'utente ha già dato il consenso.
#   frame-src https://captcha.novren.net      L'origine isolata del widget.
#
# ── Ancora da compilare ──────────────────────────────────────────────────────
#   <<<API_ORIGIN>>>   L'origine dell'Express (solo schema+host, SENZA /api).
#                      Sarà https://api.novren.net. Da mettere quando deployi il
#                      backend — insieme a VITE_API_URL in .env.production, e con
#                      un nuovo build: i due valori vanno cambiati sempre in coppia.
#
#   <<<R2_HOST>>>      https://<account>.r2.cloudflarestorage.com
#                      (o il dominio custom se metti un CDN davanti a R2).
#                      È dove vanno le PUT/GET firmate: senza, upload e download
#                      falliscono mentre la pagina sembra funzionare benissimo.
#
# ⚠️ Finché restano lì, il browser scarta quei due token come sorgenti non valide
#    (con un avviso in console) e applica il resto della direttiva. Non è un
#    problema adesso — senza backend non ci sono né API né URL firmati da chiamare.
#
# Perché `style-src 'unsafe-inline'` — non è pigrizia: PrimeVue v4 inietta il tema
# come <style> a runtime, e Vue scrive stili inline per ogni `:style`. Senza,
# l'applicazione si vede completamente senza stile. Sugli stili il rischio è
# basso; su `script-src` invece non transigiamo, ed è lì che 'unsafe-inline' NON c'è.


# ── L'origine isolata del captcha ────────────────────────────────────────────
# Vale solo se captcha.html è servita da questo stesso progetto Pages (cioè hai
# aggiunto captcha.novren.net come dominio aggiuntivo). Se invece usi un progetto
# separato, questo blocco va nel _headers di QUEL progetto.
#
# 🚨 Le tre righe qui sotto esistono per una ragione precisa, e vanno tenute INSIEME.
#
#    Pages applica **tutte** le regole che combaciano: senza le rimozioni, questa pagina
#    si prenderebbe anche gli header del blocco /*.
#
#    `! X-Frame-Options` — `DENY` colpirebbe anche questa pagina, che per costruzione vive
#    DENTRO un iframe cross-origin. Il browser rifiuterebbe di renderizzarla e mostrerebbe
#    «ha rifiutato la connessione» nel riquadro: sembra un guasto di rete e non lo è.
#    XFO non ammette eccezioni — va rimosso, non ristretto.
#
#    `! Content-Security-Policy` — meno ovvio e altrettanto fatale. Con **due** header CSP
#    il browser applica l'**intersezione**, non l'ultimo: la globale dice `script-src 'self'`
#    e quella qui sotto `'self' https://challenges.cloudflare.com`, quindi passerebbe solo
#    `'self'` e lo script di Turnstile verrebbe bloccato. Idem per `frame-ancestors`, dove
#    `'none'` della globale vincerebbe sulla lista di qui.
#    Verificato in produzione il 2026-08-13: senza questa riga arrivavano due CSP.
#
# 🚨 **Perché il blocco è duplicato su `/captcha` e `/captcha.html`.**
#    Cloudflare Pages serve i file `.html` senza estensione: una richiesta a
#    `/captcha.html` riceve un **308 verso `/captcha`**, ed è `/captcha` la pagina vera.
#    Con la regola scritta solo su `/captcha.html`, gli header finivano sulla risposta di
#    *redirect* — inutile — mentre la pagina servita ricadeva sotto `/*` e si riprendeva
#    `X-Frame-Options: DENY` e `frame-ancestors 'none'`, cioè l'iframe bloccato.
#    Verificato in produzione il 2026-08-13: `/captcha` rispondeva con XFO DENY.
#    Il codice punta a `/captcha.html` (che funziona ovunque, non solo su Pages), quindi
#    servono entrambe: una per il redirect, una per la pagina.
/captcha
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'unsafe-inline'; connect-src https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors https://novren.net
  Cache-Control: public, max-age=0, must-revalidate

/captcha.html
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'unsafe-inline'; connect-src https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors https://novren.net
  Cache-Control: public, max-age=0, must-revalidate

# `frame-ancestors https://novren.net` = chi può incorniciare questa pagina. È l'origine
# dell'app. `novren.it` non va elencato: fa 301 verso il .net, e dopo un redirect la
# pagina è servita dal .net — un redirect non è un'origine.
#
# Nota sulla CSP del captcha: è volutamente più stretta di quella dell'app.
# `default-src 'none'` e poi solo ciò che serve a Turnstile. Questa pagina non deve
# poter fare nient'altro — è la ragione per cui è separata.


# ── Cache ────────────────────────────────────────────────────────────────────
# Gli asset con hash nel nome sono immutabili: si possono cachare per sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# L'HTML no: è ciò che punta agli asset nuovi dopo un deploy. Se lo cachi, gli
# utenti restano sulla versione vecchia senza accorgersene.
# (captcha.html ha già la sua regola di cache nel blocco qui sopra.)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
